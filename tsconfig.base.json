{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "paths": {
      "@latent/tokens": ["./packages/tokens/src/index.ts"],
      "@latent/schema": ["./schema/src/index.ts"],
      "@latent/react": ["./packages/react/src/index.ts"],
      "@examples/*": ["./examples/*"]
    }
  },
  "include": [
    "packages/*/src",
    "schema/src",
    "schema/scripts",
    "validator/src",
    "site/src"
  ]
}
