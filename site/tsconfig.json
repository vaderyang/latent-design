{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": "..",
    "paths": {
      "@latent/tokens": ["packages/tokens/src/index.ts"],
      "@latent/schema": ["schema/src/index.ts"],
      "@latent/react": ["packages/react/src/index.ts"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
