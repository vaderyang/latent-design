---
import Base from "../../layouts/Base.astro";
import DemoFrame from "../../components/DemoFrame.tsx";
import data from "@examples/traceforge.json";
---

<Base title="TraceForge · Latent demo" description="高 latent — 网络/系统故障根因诊断，完整用潛 渲染。">
  <section class="wrap" style="padding-top:64px">
    <a class="demo-back" href="/">◂ Latent · 潜</a>
    <div class="kicker">应用 Demo · High latent / 故障诊断</div>
    <h2>TraceForge — 核心支付链路诊断</h2>
    <p>
      下面是这位 SRE 打开界面时看到的东西：<strong>agent 当前对故障的理解</strong>（结论先行），动作退为外围溯源。想看这份理解<em>怎么一步步形成</em>，点卡片下方的<strong>「回放」</strong>（演示用）；切到 <strong>Trace</strong> 看 builder/审计人格。provenance 标注为 <span class="mono" style="color:var(--grounded)">verifiable</span>——证据链可重新执行验证。
    </p>
    <DemoFrame data={data} mode="scenario" stepped client:load />
  </section>
</Base>
