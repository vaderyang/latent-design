---
import Base from "../../layouts/Base.astro";
import StagePanel from "../../components/StagePanel.tsx";
import "@latent/react/app";
import radapp from "@examples/rad-app.json";

const actions = [
  { label: "确认状态集，生成 v1", variant: "primary" },
  { label: "对架构决策提异议" },
  { label: "补充需求" },
];
---

<Base title="潛 IDE · Vibe Coding（应用层设计）" description="把设计语言用到 Vibe Coding IDE：agent 的理解占据主舞台，代码与终端退为外围。">
  <div class="app-frame app-vibe">
    <!-- top chrome -->
    <div class="app-topbar">
      <div class="brand"><span class="mk">潛 IDE</span> reimburse-app</div>
      <div class="tcrumb">~/reimburse-app · bun · ⌥ vibe</div>
      <div class="tright"><span class="mono" style="font-size:11px;color:var(--ink-500)">已生成 v0 · /health 200</span></div>
    </div>

    <!-- · Context — file tree (recessive) -->
    <div class="zone zone-context">
      <div class="zone-head">· Context · 文件</div>
      <div class="app-tree-row dir">▾ src/</div>
      <div class="app-tree-row">  index.ts</div>
      <div class="app-tree-row active">  routes/approvals.ts</div>
      <div class="app-tree-row">  db/schema.ts</div>
      <div class="app-tree-row">  rbac.ts</div>
      <div class="app-tree-row dir">▾ web/</div>
      <div class="app-tree-row">  App.tsx</div>
      <div class="app-tree-row dir">▾ migrations/</div>
      <div class="app-tree-row">  001_init.sql</div>
      <div class="app-tree-row">package.json</div>
    </div>

    <!-- ② Artifact — the code (co-present, neutral) -->
    <div class="zone zone-artifact">
      <div class="zone-head">② Artifact · 代码 <span class="zn">routes/approvals.ts</span></div>
      <pre class="code"><span class="c-k">import</span> {`{ Hono }`} <span class="c-k">from</span> <span class="c-s">"hono"</span>
<span class="c-k">import</span> {`{ db }`} <span class="c-k">from</span> <span class="c-s">"../db"</span>
<span class="c-k">import</span> {`{ requireRole }`} <span class="c-k">from</span> <span class="c-s">"../rbac"</span>

<span class="c-c">// 审批状态机：draft→submitted→approved/rejected→paid</span>
<span class="c-k">const</span> app = <span class="c-k">new</span> <span class="c-f">Hono</span>()

app.<span class="c-f">post</span>(<span class="c-s">"/requests"</span>, <span class="c-f">requireRole</span>(<span class="c-s">"employee"</span>), <span class="c-k">async</span> (c) => {`{`}
  <span class="c-k">const</span> body = <span class="c-k">await</span> c.req.<span class="c-f">json</span>()
  <span class="c-k">return</span> c.<span class="c-f">json</span>(<span class="c-k">await</span> db.requests.<span class="c-f">create</span>(body))
{`}`})

app.<span class="c-f">post</span>(<span class="c-s">"/requests/:id/approve"</span>, <span class="c-f">requireRole</span>(<span class="c-s">"manager"</span>), <span class="c-c">/* … */</span>)
</pre>
    </div>

    <!-- · Activity — terminal / tool calls (peripheral, recede) -->
    <div class="zone zone-activity">
      <div class="zone-head">· Activity · 终端 / 工具调用（外围 · 可审计）</div>
      <div class="app-row"><span class="dot"></span>scaffold · 生成 7 文件 + 迁移 + 种子</div>
      <div class="app-row"><span class="dot"></span>run_migration · requests/users/approvals 建表</div>
      <div class="app-row"><span class="dot"></span>smoke_test · /health 200 · 启动 0.3s</div>
      <div class="app-row muted"><span class="dot"></span>bun run dev · watching…</div>
    </div>

    <!-- ① Stage — the agent's understanding (lit primary plane) -->
    <div class="zone zone-stage">
      <div class="zone-note">
        在多数 AI IDE，这块是<b>工具调用流</b>（“正在装依赖…正在编辑 App.tsx…”）。潛 IDE 把它换成 agent 对<b>“要建什么”的理解</b>——需求、架构决策、计划与风险。代码在中间、终端在下方，都退为外围。
      </div>
      <StagePanel data={radapp} heading="agent 的理解" actions={actions} client:load />
    </div>
  </div>

  <style>
    .app-vibe {
      grid-template-columns: 196px minmax(0, 1fr) minmax(380px, 460px);
      grid-template-rows: 46px minmax(0, 1fr) 172px;
      grid-template-areas:
        "top top top"
        "ctx art stage"
        "ctx act stage";
    }
    .code {
      margin: 0;
      padding: 14px 16px;
      font-family: var(--mono);
      font-size: 12.5px;
      line-height: 1.7;
      color: var(--ink-300);
      white-space: pre-wrap;
      overflow: auto;
    }
    .code .c-k { color: var(--open); }
    .code .c-s { color: var(--grounded); }
    .code .c-f { color: var(--hypo); }
    .code .c-c { color: var(--ink-500); font-style: italic; }
  </style>
</Base>
